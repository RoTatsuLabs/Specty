    <!-- Library credits -->
    <string name="lib_specty_summary">Penganalisis kualitas audio untuk Android.</string>
    <string name="lib_specty_note">Specty adalah perangkat lunak bebas di bawah GNU General Public License, versi 3. Anda dapat menggunakan, mempelajari, mengubah, dan membagikannya sesuai ketentuan tersebut.</string>
    <string name="lib_ffmpeg_summary">FFmpeg untuk Android melalui FFmpegKitNext, kelanjutan dari ffmpeg-kit milik Arthenica.</string>
    <string name="lib_ffmpeg_note">Membaca dan mendekode setiap file audio yang dianalisis Specty. Mencakup pustaka FFmpeg (libavcodec, libavformat, libavutil, dan lainnya), juga di bawah LGPL. Kode sumbernya tersedia di tautan di atas.</string>
    <string name="lib_mornye_summary">Pemeriksaan Hi-Res untuk upsampling dan lantai derau audio 16-bit, dari aplikasi musik Mornye.</string>
    <string name="lib_mornye_note">Pemeriksaan sample-and-hold, interpolasi, dan lantai derau 16-bit di Specty adalah port Kotlin dari kode bukti Hi-Res Mornye, dipakai di bawah LGPL dan digabungkan dengan Specty di bawah GPL. Terima kasih kepada para penulisnya. Kode sumbernya tersedia di tautan di atas.</string>
    <string name="lib_compose_summary">Toolkit UI: UI, Graphics, Foundation, Material 3, dan Material Icons Extended.</string>
    <string name="lib_compose_note">Menggambar seluruh antarmuka. Ikonnya berasal dari kumpulan Material Icons.</string>
    <string name="lib_activity_summary">Integrasi Compose untuk activity, result contract, dan edge-to-edge.</string>
    <string name="lib_lifecycle_summary">ViewModel dan state yang peka siklus hidup untuk Compose.</string>
    <string name="lib_core_summary">Ekstensi Kotlin untuk framework Android.</string>
    <string name="lib_androidx_summary">Annotation, Collection, Saved State, Startup, dan pustaka AndroidX lain yang menjadi dependensi pustaka di atas.</string>
    <string name="lib_kotlin_summary">Runtime Kotlin.</string>
    <string name="lib_coroutines_summary">Pekerjaan latar belakang dan pembatalan untuk analisis dan pemindaian pustaka.</string>

