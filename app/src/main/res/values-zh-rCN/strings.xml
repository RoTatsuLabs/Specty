    <!-- Library credits -->
    <string name="lib_specty_summary">Android 音频质量分析工具。</string>
    <string name="lib_specty_note">Specty 是自由软件，遵循 GNU 通用公共许可证第 3 版。你可以依据这些条款使用、研究、修改和分享它。</string>
    <string name="lib_ffmpeg_summary">通过 FFmpegKitNext 提供的适用于 Android 的 FFmpeg，是 Arthenica 的 ffmpeg-kit 的延续。</string>
    <string name="lib_ffmpeg_note">读取并解码 Specty 分析的每一个音频文件。其中包含 FFmpeg 库（libavcodec、libavformat、libavutil 等），同样遵循 LGPL。源代码可通过上方链接获取。</string>
    <string name="lib_mornye_summary">来自 Mornye 音乐应用的 Hi-Res 检测：升采样与 16 位噪声底。</string>
    <string name="lib_mornye_note">Specty 的采样保持、插值和 16 位噪声底检测，是 Mornye Hi-Res 证据代码的 Kotlin 移植版，依据 LGPL 使用，并依据 GPL 与 Specty 合并。感谢其作者。源代码可通过上方链接获取。</string>
    <string name="lib_compose_summary">UI 工具包：UI、Graphics、Foundation、Material 3 和 Material Icons Extended。</string>
    <string name="lib_compose_note">绘制整个界面。图标来自 Material Icons 图标集。</string>
    <string name="lib_activity_summary">面向 Activity、结果协定和边到边显示的 Compose 集成。</string>
    <string name="lib_lifecycle_summary">适用于 Compose 的 ViewModel 与生命周期感知状态。</string>
    <string name="lib_core_summary">Android 框架的 Kotlin 扩展。</string>
    <string name="lib_androidx_summary">Annotation、Collection、Saved State、Startup 以及上述库所依赖的其他 AndroidX 库。</string>
    <string name="lib_kotlin_summary">Kotlin 运行时。</string>
    <string name="lib_coroutines_summary">用于分析和曲库扫描的后台任务与取消机制。</string>

