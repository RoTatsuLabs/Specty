    <!-- Library credits -->
    <string name="lib_specty_summary">Audio quality analyser for Android.</string>
    <string name="lib_specty_note">Specty is free software under the GNU General Public License, version 3. You can use, study, change and share it under those terms.</string>
    <string name="lib_ffmpeg_summary">FFmpeg for Android, a continuation of the retired Arthenica ffmpeg-kit.</string>
    <string name="lib_ffmpeg_note">Reads and decodes every audio file Specty analyses. It includes the FFmpeg libraries (libavcodec, libavformat, libavutil and others), also under the LGPL. The source is available from the link above.</string>
    <string name="lib_compose_summary">UI toolkit: UI, Graphics, Foundation, Material 3 and Material Icons Extended.</string>
    <string name="lib_compose_note">Draws the whole interface. The icons come from the Material Icons set.</string>
    <string name="lib_activity_summary">Compose integration for activities, result contracts and edge-to-edge.</string>
    <string name="lib_lifecycle_summary">ViewModel and lifecycle-aware state for Compose.</string>
    <string name="lib_core_summary">Kotlin extensions for the Android framework.</string>
    <string name="lib_androidx_summary">Annotation, Collection, Saved State, Startup and other AndroidX libraries that the ones above depend on.</string>
    <string name="lib_kotlin_summary">The Kotlin runtime.</string>
    <string name="lib_coroutines_summary">Background work and cancellation for analysis and library scanning.</string>

